# Compose reads this file to fill in the values below.
# All values are dev placeholders — never use them in production.
# .env is git-ignored, so copy this file and change what you need.
#
# The Go server does NOT read this file. Set its env manually:
#   $env:DATABASE_URL = "..."     (PowerShell)
#   export DATABASE_URL=...       (bash)
# before running `go run ./cmd/server`.
#
# DATABASE_URL below connects to Postgres from your HOST, so use the published port
# (POSTGRES_HOST_PORT), not 5432. If the backend runs as a compose service instead,
# use "postgres:5432" — the service name on the internal network.

POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale
POSTGRES_DB=flashsale
POSTGRES_HOST_PORT=5433